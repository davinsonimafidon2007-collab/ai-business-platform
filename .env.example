# =============================================================================
# AI Business Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
APP_URL=http://localhost:3001
APP_NAME=AI Business Platform API

# --- Security (REQUIRED) ---
# MUST be at least 32 characters or the app will refuse to start
# (environment=test is the only exception; it injects a test secret).
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Uso personal: sin login (PERSONAL.NOAUTH) ---
# Si True, el backend NO exige JWT: inyecta un usuario local ADMIN (get-or-create).
# Para uso SOLO local/tu máquina. En un despliegue público dejar false,
# si no cualquiera con acceso al puerto sería ADMIN.
AUTH_DISABLED=false
# Con ENVIRONMENT=production + AUTH_DISABLED=true la app NO arranca (fail-fast).
# Override explícito solo si el puerto no está expuesto y lo asumes:
ALLOW_AUTH_DISABLED_IN_PROD=false

# --- CORS ---
# Development: localhost + Capacitor OK (kept by default so local DX works).
# Production: lista explícita de orígenes HTTPS del frontend. NUNCA '*', nunca
# vacío, y no dejar SOLO localhost/capacitor/ionic. Si ENVIRONMENT=production
# infringe estas reglas, Settings no carga y la app no arranca (SEC-001).
# CORS_ORIGINS=https://app.tudominio.com,https://www.tudominio.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080,capacitor://localhost,ionic://localhost,http://localhost,https://localhost
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# En production se endurece automáticamente si queda "*"
# (Authorization,Content-Type,Accept,X-Request-ID,X-API-Key,X-Requested-With).
CORS_ALLOW_HEADERS=*
HTTPS_REDIRECT=false
SECURITY_HEADERS_ENABLED=true
TRUSTED_HOSTS=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_business_platform
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30.0
DATABASE_POOL_PRE_PING=true

# --- Redis (REQUIRED in production; optional in local development) ---
# En producción Redis es OBLIGATORIO: rate-limit y cache distribuido dependen de él.
# En development/test el rate-limit cae a memoria si Redis no está disponible.
#
# PERF-001 (mode visibility): toda respuesta del middleware lleva
#   X-RateLimit-Mode: redis | memory
# donde "memory" indica degradación a contadores en memoria (no distribuidos).
# En production una caída de Redis loguea ERROR (throttled ~1 log/10s por
# proceso) — nunca es silencioso.
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=2.0

# --- Paginación (PERF-001) ---
# Los listados críticos (vehicles, deals, opportunities, searches) validan
# `limit` en [1, 100] (422 si se supera) y los repositorios además recortan a
# 100 por defensa en profundidad. `offset` >= 0.
#   GET /api/v1/vehicles?limit=1000  -> 422

# --- SMTP / Email ---
# Leave empty to log emails instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# --- Alertas email de oportunidades (requiere SMTP_* configurado) ---
OPPORTUNITY_ALERT_ENABLED=true
OPPORTUNITY_ALERT_MIN_RECOMMENDATION=BUY
OPPORTUNITY_ALERT_MIN_SCORE=0
OPPORTUNITY_ALERT_COOLDOWN_HOURS=24

# --- Alertas Telegram de oportunidades (Task C.3) ---
# Bot token del BotFather. Vacío -> Telegram alerts deshabilitado (log-only).
TELEGRAM_BOT_TOKEN=
# chat_id del canal/grupo (ej: -100123... o @canal). Vacío -> dry-run.
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_ENABLED=true
TELEGRAM_ALERT_MIN_RECOMMENDATION=BUY
TELEGRAM_ALERT_MIN_SCORE=0
TELEGRAM_ALERT_MIN_MARGIN_PERCENT=0
TELEGRAM_ALERT_COOLDOWN_HOURS=6

# --- Firebase (Google Login) ---
# Service account JSON string OR path. Never commit real credentials.
# Sin credenciales: en development/test la app arranca igual (WARNING, Google
# Login deshabilitado). En production con FIREBASE_REQUIRED=true la app NO
# arranca sin credenciales (fail-fast, SEC-001).
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_REQUIRED=false

# --- Scheduler ---
ENABLE_SCHEDULER=true
CACHE_REFRESH_INTERVAL=3600
SEARCH_HISTORY_TTL=2592000
MARKET_CACHE_TTL=21600
MAX_CONCURRENT_JOBS=4

# Canary de scrapers (0 = desactivado). Default 6h
PROVIDER_CANARY_INTERVAL=21600

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_PREMIUM=120
RATE_LIMIT_USER=30
RATE_LIMIT_READONLY=10

# --- API Key ---
API_KEY_PREFIX=abp_live
API_KEY_LENGTH=32

# --- Provider HTTP Client ---
PROVIDER_HTTP_TIMEOUT=30.0
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_RETRY_BACKOFF_MIN=1
PROVIDER_HTTP_RETRY_BACKOFF_MAX=60
# Proxy residencial (mobile.de y autoscout24 DE anti-bot). Ej: http://user:pass@host:port
# AutoScout24 ES funciona sin proxy desde datacenter IPs en la mayoría de casos.
PROVIDER_HTTP_PROXY=
# Cookies de navegador real (opcional)
PROVIDER_HTTP_COOKIES=
# Delay mínimo entre peticiones (ms). 0 = off. Prod: 800–1500
PROVIDER_HTTP_MIN_DELAY_MS=0
# mobile.de es opcional (CRIT.001): sin proxy residencial da 403 anti-bot
# desde IPs datacenter. AutoScout24 DE/ES es la fuente primaria. Sin proxy,
# mejor desactivarlo para no gastar tiempo/retries en una fuente caída.
ENABLE_MOBILE_DE=false
# Playwright para mobile.de (sin cuenta). Si true, usa browser headless con JS
# para bypass parcial anti-bot; cae a httpx si falla. Requiere `playwright install chromium`.
ENABLE_MOBILE_DE_PLAYWRIGHT=false
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_HEADLESS=true

# --- Upload ---
UPLOAD_DIR=uploads/inspection_photos

# --- Economics / Import cost profile ---
# Perfil destino (SPAIN|PORTUGAL|GERMANY|FRANCE|DEFAULT). Con SPAIN/ES se auto-registran
# fixtures offline es_market_fixture + coches_net_fixture en el registry
# (comparables). autoscout24_es sigue requiriendo ENABLE_AUTOSCOUT24_ES=true.
DEFAULT_IMPORT_COST_PROFILE=SPAIN
# Los valores de los perfiles (SPAIN, PORTUGAL, GERMANY, FRANCE, DEFAULT) viven en
# app/config/import_costs_data.json (versionado, version: 2026.08). Editarlo para
# actualizar costes; el ProfitAnalyzer los carga al importar app.config.import_costs
# (ECON-001). Los perfiles con valores fuera de rango fallan al cargar (ValueError).

# --- Modo del pipeline de datos ES (TASK 1) ---
# "fixture" (default): los comparables ES salen de datos SIMULADOS offline
#   (es_market_fixture, coches_net_fixture, coches_net_html_fixture). Solo
#   dev/test: la API loggea un WARNING al arrancar y /health expone
#   es_data_mode para que la UI muestre banner de "datos de demostración".
# "live": los fixtures ES NO se registran bajo ninguna circunstancia (ni por
#   perfil SPAIN ni por los flags ENABLE_*_FIXTURE de abajo). TASK 2 registra
#   el provider coches_net real (scraping). Un valor inválido impide el arranque.
ES_DATA_MODE=fixture

# --- Provider offline de comparables ES (fixtures JSON). Sin red. ---
# Con perfil SPAIN/ES se auto-registra sin tocar este flag.
# Ignorado si ES_DATA_MODE=live.
ENABLE_ES_MARKET_FIXTURE=false
# Si True, desactiva el auto-registro de fixtures ES por perfil SPAIN.
DISABLE_ES_MARKET_AUTO=false

# AutoScout24 ES (comparables mercado destino HTTP). Habilitado tras smoke live.
# Se auto-registra en SearchEngineService cuando está activado.
ENABLE_AUTOSCOUT24_ES=true

# Coches.net offline (fixtures JSON). Sin red. Default off.
# Con perfil SPAIN/ES se auto-registra sin tocar este flag.
# Ignorado si ES_DATA_MODE=live.
ENABLE_COCHES_NET_FIXTURE=false

# --- Alertas por racha de fallos de jobs (requiere SMTP_* configurado) ---
JOB_FAILURE_ALERT_ENABLED=true
JOB_FAILURE_ALERT_THRESHOLD=3
JOB_FAILURE_ALERT_COOLDOWN_HOURS=6
# Direccion de ops. Vacio = solo log (no envia)
JOB_FAILURE_ALERT_TO_EMAIL=

# --- Backups Postgres (DEVOPS-001 / P3-002) ---
# Usados por scripts/backup_postgres.sh y scripts/restore_postgres.sh.
BACKUP_DIR=./backups
BACKUP_RETENTION=7
# Passphrase para encriptar dumps con AES256 (gpg). TASK-014.
# Dejar vacío = dumps sin encriptar (solo en dev).
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_ACCESS_LOG=true
MAX_LOG_BODY_SIZE=4096

# --- Observabilidad opcional (fase 2, DEVOPS-001) ---
# Solo si usas docker compose --profile obs (prometheus+grafana).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Search orders (scheduler) ---
SEARCH_ORDER_INTERVAL=60
SEARCH_ORDERS_PER_RUN=5
SEARCH_ORDER_STALE_MINUTES=15
SEARCH_ORDER_MAX_ATTEMPTS=5
SEARCH_ORDER_RETRY_COOLDOWN_MINUTES=30
SEARCH_ORDER_MAX_PENDING_PER_USER=10

# --- Filtro de comparables (SEARCH.PROVIDERS.1) ---
# Opcional: limitar sources del estimador de mercado. Vacío = todos los del registry.
# Ej: COMPARABLE_PROVIDERS=mobile_de,autoscout24,autoscout24_es,es_market_fixture
COMPARABLE_PROVIDERS=
# --- Modo de la app (APP_MODE) ---
# personal (uso local / un solo usuario) | multiuser. Default: personal.
# OJO: APP_MODE es solo documentación de intención; NO desactiva el login.
# Para entrar sin login usa AUTH_DISABLED=true (arriba).
APP_MODE=personal

# --- Google OAuth (Capacitor) ---
# Get these from Google Cloud Console > APIs & Services > Credentials.
# DO NOT commit real values to git. Use google-services.json.example as template.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# =============================================================================
# --- Docker Compose (docker-compose.yml / docker-compose.dev.yml) ---
# =============================================================================
# Desarrollo local con hot-reload del backend (bind-mount del repo):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up
# Para no escribir los -f cada vez, descomenta la línea siguiente:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Puerto/publish de la API en el host (default 127.0.0.1:8001 → interno 8000).
# En un servidor público deja API_HOST=127.0.0.1 y sirve vía reverse proxy;
# usa 0.0.0.0 solo si expones el puerto directamente y lo asumes.
API_HOST=127.0.0.1
API_PORT=8001
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3001
# NEXT_PUBLIC_* se inlinean en el bundle del frontend EN BUILD TIME
# (docker compose build); cámbialos ANTES de construir la imagen.
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_AUTH_DISABLED=false

# Bases de datos: publicados solo en loopback por seguridad (override con
# DB_HOST/REDIS_HOST=0.0.0.0 si necesitas acceso externo).
DB_HOST=127.0.0.1
DB_PORT=5433
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
