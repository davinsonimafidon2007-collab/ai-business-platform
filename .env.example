# ===========================================
# Environment Configuration
# ===========================================
# Values: development, production, test
ENVIRONMENT=development

# ===========================================
# Application Metadata
# ===========================================
APP_NAME=AI Business Platform API
APP_DESCRIPTION=API for the AI Business Platform.
APP_VERSION=0.1.0

# ===========================================
# Database Configuration
# ===========================================
# Format: postgresql+asyncpg://user:password@host:port/database
# Example: postgresql+asyncpg://user:pass@localhost:5432/mydb
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_business_platform

# ===========================================
# JWT Configuration
# ===========================================
# IMPORTANT: Change this in production! Use a strong random string (min 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# Access token expiration time in minutes (short-lived, default: 30 minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration time in minutes (long-lived, default: 7 days)
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# Security Configuration
# ===========================================
# Password hashing algorithm (bcrypt recommended)
PASSWORD_HASH_ALGORITHM=bcrypt
# Bcrypt rounds (higher = more secure but slower, recommended: 12)
BCRYPT_ROUNDS=12

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins (no spaces)
# Development: http://localhost:3000,http://localhost:5173,http://localhost:8080
# Production: https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=true
# Allowed HTTP methods
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# Allowed headers
CORS_ALLOW_HEADERS=*

# ===========================================
# Logging Configuration
# ===========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default is INFO in production, DEBUG in development
LOG_LEVEL=INFO
# Log format: text (development) or json (production)
LOG_FORMAT=text

# ===========================================
# API Configuration
# ===========================================
# API prefix for all routes
API_PREFIX=/api/v1
# Enable documentation in development
ENABLE_DOCS=true

# ===========================================
# Rate Limiting Configuration
# ===========================================
# Global rate limit: requests per minute per IP
RATE_LIMIT_GLOBAL=60
# Rate limit for login endpoint: requests per minute per IP
RATE_LIMIT_LOGIN=5
# Rate limit for register endpoint: requests per minute per IP
RATE_LIMIT_REGISTER=10

# ===========================================
# Password Reset Configuration
# ===========================================
# Token expiration time in hours (default: 1 hour)
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ===========================================
# Admin User Configuration
# ===========================================
# These variables are used by app/scripts/create_admin.py
# to create the first admin user non-interactively.
# If not set, the script will run in interactive mode.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-secure-password-here

# ===========================================
# SMTP Configuration (Optional)
# ===========================================
# These variables are used by SmtpEmailProvider to send emails.
# If not set, emails are logged instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_USE_TLS=true

# ===========================================
# External Services (Optional)
# ===========================================
# Add your external service API keys here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REDIS_URL=redis://localhost:6379/0
