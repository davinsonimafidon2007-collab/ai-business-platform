# =============================================================================
# AI Business Platform - Environment PRODUCTION (template)
# =============================================================================
# Copia a .env.production en el servidor de producción y rellena valores reales.
# NUNCA commitees valores reales. (Bloque 6 / DEVOPS)
# =============================================================================

# --- Application ---
ENVIRONMENT=production
APP_URL=https://app.example.com
APP_NAME=AI Business Platform API

# --- Security (REQUIRED, >=32 chars) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_prod_secret_at_least_32_chars_long

# --- Auth SIEMPRE activa en producción (fail-fast si se fuerza true) ---
AUTH_DISABLED=false
ALLOW_AUTH_DISABLED_IN_PROD=false
HTTPS_REDIRECT=true

# --- CORS (SOLO dominios de producción; nunca '*') ---
CORS_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Request-ID,X-API-Key,X-Requested-With
HTTPS_REDIRECT=true
SECURITY_HEADERS_ENABLED=true
TRUSTED_HOSTS=app.example.com

# --- Database (credenciales seguras propias de producción) ---
DATABASE_URL=postgresql+asyncpg://user_prod:pass_prod@db:5432/ai_business_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30.0
DATABASE_POOL_PRE_PING=true

# --- Redis (obligatorio en producción) ---
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_TIMEOUT=2.0

# --- SMTP / Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@app.example.com
SMTP_USE_TLS=true

# --- Firebase / Google Login (credenciales de producción, REQUIRED) ---
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_REQUIRED=true

# --- Scheduler ---
ENABLE_SCHEDULER=true
CACHE_REFRESH_INTERVAL=3600
SEARCH_HISTORY_TTL=2592000
MARKET_CACHE_TTL=21600
MAX_CONCURRENT_JOBS=4
PROVIDER_CANARY_INTERVAL=21600

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_PREMIUM=120
RATE_LIMIT_USER=30
RATE_LIMIT_READONLY=10

# --- API Key ---
API_KEY_PREFIX=abp_live
API_KEY_LENGTH=32

# --- Provider HTTP (claves de producción) ---
PROVIDER_HTTP_TIMEOUT=30.0
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_RETRY_BACKOFF_MIN=1
PROVIDER_HTTP_RETRY_BACKOFF_MAX=60
PROVIDER_HTTP_PROXY=
PROVIDER_HTTP_COOKIES=
PROVIDER_HTTP_MIN_DELAY_MS=1200
ENABLE_MOBILE_DE=false

# --- Economics ---
DEFAULT_IMPORT_COST_PROFILE=SPAIN

# --- Providers offline/comparables ---
ES_DATA_MODE=live
ENABLE_ES_MARKET_FIXTURE=false
DISABLE_ES_MARKET_AUTO=false
ENABLE_AUTOSCOUT24_ES=true
ENABLE_COCHES_NET_FIXTURE=false
COMPARABLE_PROVIDERS=
ENABLE_MOBILE_DE_PLAYWRIGHT=false
PLAYWRIGHT_TIMEOUT_MS=30000

# --- Backups (DEVOPS-001) ---
BACKUP_DIR=/var/backups
BACKUP_RETENTION=14
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Observabilidad (perfil obs) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_prod_grafana

# --- Stack docker de producción (TASK 8 / AUD-025) ---
# Arrancar SIEMPRE con el override de producción:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# Sin él, el contenedor monta el código del host y publica Postgres/Redis.
# Estas tres son obligatorias: compose se niega a arrancar si faltan.
POSTGRES_USER=CHANGE_ME_prod_db_user
POSTGRES_PASSWORD=CHANGE_ME_prod_db_password
REDIS_PASSWORD=CHANGE_ME_prod_redis_password

# /docs y /openapi.json quedan cerrados en producción por defecto (AUD-023).
# Poner true solo si la instancia es interna y se quiere la doc expuesta.
ENABLE_DOCS=false

# --- Modo de la app ---
APP_MODE=multiuser

# --- Logging ---
LOG_LEVEL=WARNING
LOG_JSON=true
ENABLE_ACCESS_LOG=true
