# =============================================================================
# AI Business Platform — Environment PERSONAL (VPS único, uso propio)
# =============================================================================
# Copia a .env.personal en el VPS y rellena los valores marcados CHANGE_ME.
# NUNCA commitees valores reales.
#
# Por qué este archivo existe y no basta con .env.production.example:
# .env.production.example está escrito para un SaaS multiusuario real
# (AUTH_DISABLED=false, FIREBASE_REQUIRED=true, APP_MODE=multiuser) — el
# modelo que este proyecto explícitamente NO es (ver AGENTS.md: "PERSONAL-USE
# application... no login, registration, OAuth, SSO"). Usar ese template tal
# cual en el despliegue real rompería la app (exigiría un login que nunca se
# configuró). Este template refleja el modo real de la aplicación.
# =============================================================================

# --- Application ---
ENVIRONMENT=production
# https://api.<lo que pongas en DOMAIN más abajo> — lo rellena scripts/deploy,
# no hace falta tocarlo aquí si DOMAIN ya está bien.
APP_URL=https://CHANGE_ME_your_domain.example
APP_NAME=AI Business Platform API

# --- Dominio (usado por Caddy — docker-compose.caddy.yml / Caddyfile) ---
# Debe ser un dominio REAL con DNS ya apuntando a la IP del VPS (registro A
# para DOMAIN y para api.DOMAIN) — sin esto Caddy no puede emitir el
# certificado HTTPS. No uses una IP desnuda: Let's Encrypt no emite
# certificados para IPs.
DOMAIN=CHANGE_ME_your_domain.example
ACME_EMAIL=CHANGE_ME_your_email@example.com

# --- Security (REQUIRED, >=32 chars) ---
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_prod_secret_at_least_32_chars_long

# --- Auth: este proyecto es de uso personal, sin login (AGENTS.md) ---
# AMBAS deben ser true — ENVIRONMENT=production + AUTH_DISABLED=true sin
# ALLOW_AUTH_DISABLED_IN_PROD=true hace que la app se niegue a arrancar
# (guard fail-fast intencional en app/main.py). Esto es correcto y
# esperado para este modo: es una decisión consciente, no un descuido.
AUTH_DISABLED=true
ALLOW_AUTH_DISABLED_IN_PROD=true
HTTPS_REDIRECT=true

# --- CORS ---
# Incluye el dominio real (web) + los orígenes nativos de Capacitor. NUNCA
# '*' en producción (la app lo rechaza).
CORS_ORIGINS=https://CHANGE_ME_your_domain.example,capacitor://localhost,https://localhost
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Request-ID,X-API-Key,X-Requested-With
SECURITY_HEADERS_ENABLED=true
TRUSTED_HOSTS=CHANGE_ME_your_domain.example,api.CHANGE_ME_your_domain.example

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ai_business:CHANGE_ME_prod_db_password@db:5432/ai_business_platform
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30.0
DATABASE_POOL_PRE_PING=true

# --- Redis ---
REDIS_URL=redis://:CHANGE_ME_prod_redis_password@redis:6379/0
REDIS_SOCKET_TIMEOUT=2.0

# --- Firebase / Google Login: NO SE USA en modo personal ---
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_REQUIRED=false

# --- Scheduler ---
ENABLE_SCHEDULER=true
CACHE_REFRESH_INTERVAL=3600
SEARCH_HISTORY_TTL=2592000
MARKET_CACHE_TTL=21600
MAX_CONCURRENT_JOBS=2
PROVIDER_CANARY_INTERVAL=21600

# --- Rate Limiting (un único usuario — límites generosos, no hay abuso multiusuario que mitigar) ---
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_PREMIUM=120
RATE_LIMIT_USER=60
RATE_LIMIT_READONLY=20

# --- API Key ---
API_KEY_PREFIX=abp_live
API_KEY_LENGTH=32

# --- Provider HTTP ---
PROVIDER_HTTP_TIMEOUT=30.0
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_RETRY_BACKOFF_MIN=1
PROVIDER_HTTP_RETRY_BACKOFF_MAX=60
# Rellena solo si compras un proxy residencial (ver docs/PROXY_MOBILE_DE.md).
PROVIDER_HTTP_PROXY=
PROVIDER_HTTP_COOKIES=
PROVIDER_HTTP_MIN_DELAY_MS=1200
ENABLE_MOBILE_DE=false

# --- OpenClaw (opcional — ver ADR-006, docs/PROXY_MOBILE_DE.md) ---
ENABLE_OPENCLAW_BROWSER=false
OPENCLAW_ENDPOINT=
OPENCLAW_AGENT_ID=mobile-de-browser
OPENCLAW_TIMEOUT_MS=45000

# --- Economics ---
DEFAULT_IMPORT_COST_PROFILE=SPAIN

# --- Providers offline/comparables ---
ES_DATA_MODE=live
ENABLE_ES_MARKET_FIXTURE=false
DISABLE_ES_MARKET_AUTO=false
ENABLE_AUTOSCOUT24_ES=true
ENABLE_COCHES_NET_FIXTURE=false
ENABLE_MOBILE_DE_PLAYWRIGHT=false
PLAYWRIGHT_TIMEOUT_MS=30000

# --- Backups ---
BACKUP_DIR=/var/backups
BACKUP_RETENTION=14
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_backup_passphrase

# --- Stack docker (usar SIEMPRE los 3 overrides juntos) ---
#   docker compose \
#     -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.caddy.yml \
#     up -d --build
# Sin docker-compose.prod.yml: el contenedor monta el código del host y
# publica Postgres/Redis. Sin docker-compose.caddy.yml: no hay HTTPS ni
# dominio — solo puertos internos sin punto de entrada público.
# Estas tres son obligatorias: compose se niega a arrancar si faltan.
POSTGRES_USER=ai_business
POSTGRES_PASSWORD=CHANGE_ME_prod_db_password
REDIS_PASSWORD=CHANGE_ME_prod_redis_password

# /docs y /openapi.json cerrados por defecto — no hay razón para abrirlos
# en un despliegue personal expuesto a internet.
ENABLE_DOCS=false

# --- Modo de la app: PERSONAL, no multiuser ---
APP_MODE=personal

# --- Logging ---
LOG_LEVEL=WARNING
LOG_JSON=true
ENABLE_ACCESS_LOG=true
