# frontend/android/keystore.properties.example
# Copia este archivo a keystore.properties y rellena con tus valores reales
# ⚠️ NO subas keystore.properties al repositorio (está en .gitignore)

storeFile=release-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD_HERE
keyAlias=prod-release
keyPassword=YOUR_KEY_PASSWORD_HERE
