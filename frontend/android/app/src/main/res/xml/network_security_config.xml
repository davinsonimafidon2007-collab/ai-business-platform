<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuración base: por defecto, denegar cleartext -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Excepción SOLO para desarrollo local (Android Emulator / USB Debug) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Configuración para el dominio de producción (Reemplazar 'api.aibusiness.com' con el dominio real) -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- TODO DESARROLLADOR: Reemplazar con el dominio real de la API en producción -->
        <domain includeSubdomains="true">api.aibusiness.com</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>

        <!-- Certificate Pinning (Placeholder: generar hash real con scripts/generate-cert-pin.sh) -->
        <pin-set expiration="2026-12-31">
            <!-- Hash de ejemplo, debe ser reemplazado por el hash SHA-256 del certificado de producción -->
            <pin digest="SHA-256">REPLACE_WITH_REAL_SHA256_HASH_OF_PROD_CERT=</pin>
            <!-- Pin de respaldo (Backup pin) en caso de rotación de certificados -->
            <pin digest="SHA-256">REPLACE_WITH_BACKUP_SHA256_HASH=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
