<?xml version="1.0" encoding="utf-8"?>
<!--
  MOBILE.API.1: cleartext HTTP solo para el backend local de desarrollo.

  Certificate Pinning (MOB-P3-005):
    - El host de producción (aibusiness.app) usa certificate pinning SHA-256.
    - IMPORTANTE: reemplaza REPLACE_WITH_REAL_PIN_1 / REPLACE_WITH_REAL_PIN_2
      por los hashes reales generados con:
        npm run generate:pin   (frontend)
    - Pin 1 = certificado/CA del dominio. Pin 2 = backup (otra CA / cert).
    - Solo efectivo en HTTPS; los hosts de desarrollo (cleartext) se excluyen
      para no romper el dev local.
-->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">aibusiness.app</domain>
        <pin-set expiration="2029-12-31">
            <pin digest="SHA-256">REPLACE_WITH_REAL_PIN_1</pin>
            <pin digest="SHA-256">REPLACE_WITH_REAL_PIN_2</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
    <!-- Dev: cleartext solo para los hosts locales, resto exige HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.1.138</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
