<?xml version="1.0" encoding="utf-8"?>
<!--
  MOB-P1-007: Network security config — build type RELEASE (src/main).

  Política de producción: el cleartext HTTP NO está permitido por defecto
  (base-config = false). Solo hosts de desarrollo locales (10.0.2.2 emulador,
  localhost WebView) tienen cleartext permitido para poder hablar con un
  backend en http:// durante el desarrollo con APK debug.

  Para desarrollo con dispositivo físico contra el PC por LAN se usa la
  build DEBUG (src/debug/res/xml/network_security_config.xml).

  TODO (MOB-P3-005): certificate pinning para el host de producción
  (aibusiness.app). Reemplazar REPLACE_WITH_REAL_PIN_1 / _2 por los SHA-256
  reales (npm run generate:pin en frontend) antes de activar el <pin-set>.
  Sin hashes reales NO debe activarse: rompería la comunicación HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Dev: cleartext solo para los hosts locales, resto exige HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>