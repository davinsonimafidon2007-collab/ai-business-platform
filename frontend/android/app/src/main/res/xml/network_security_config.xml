<?xml version="1.0" encoding="utf-8"?>
<!--
  MOB-P1-007 / MOBILE-HARDENING #7: Network security config — build RELEASE.

  Política de producción estricta:
    - HTTPS obligatorio: base-config cleartextTrafficPermitted=false.
    - Sin excepciones de dominio: el cleartext de desarrollo (10.0.2.2,
      localhost) vive EXCLUSIVAMENTE en src/debug/res/xml/, que solo se
      aplica a builds debug y nunca hereda al release.
    - Trust anchors: únicamente CAs del sistema (user CAs no confían en
      release por defecto en API 24+).

  TODO (MOB-P3-005): certificate pinning para el host de producción
  (aibusiness.app). Reemplazar REPLACE_WITH_REAL_PIN_1 / _2 por los SHA-256
  reales (npm run generate:pin en frontend) antes de activar el <pin-set>.
  Sin hashes reales NO debe activarse: rompería la comunicación HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>