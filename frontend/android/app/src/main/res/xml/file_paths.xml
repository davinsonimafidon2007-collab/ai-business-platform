<?xml version="1.0" encoding="utf-8"?>
<!--
  MOBILE-HARDENING #6: rutas FileProvider restringidas a almacenamiento de la
  app. Se eliminó external-path name="my_images" path="." porque exponía TODA
  la memoria externa compartida vía el provider (superficie de fuga de datos).
  Cámara/Share siguen funcionando: los plugins escriben en cache/files de la
  app, cubiertos por las cuatro rutas siguientes.
-->
<paths>
    <files-path name="app_files" path="." />
    <cache-path name="app_cache" path="." />
    <external-files-path name="app_external_files" path="." />
    <external-cache-path name="app_external_cache" path="." />
</paths>
