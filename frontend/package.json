{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mobile": "vitest run src/__tests__/mobile/",
    "test:release": "vitest run src/__tests__/release/",
    "test:e2e": "playwright test",
    "test:perf": "bash scripts/performance-test.sh",
    "test:lighthouse": "bash scripts/lighthouse-audit.sh",
    "test:all": "npm run test:run && npm run test:release",
    "export": "next build",
    "check:cap-config": "node scripts/check-capacitor-config.mjs",
    "cap:sync": "npm run check:cap-config && npm run export && npx cap sync",
    "cap:sync:android": "npm run check:cap-config && npm run export && npx cap sync android",
    "cap:open:android": "npm run check:cap-config && npx cap open android",
    "cap:build:android": "npm run cap:sync:android && cd android && gradlew.bat assembleDebug",
    "generate:pin": "bash scripts/generate-pin.sh",
    "analyze:bundle": "bash scripts/analyze-bundle.sh",
    "pwa:generate": "pwa-asset-generator --icon-only --manifest public/manifest.json"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@capgo/capacitor-native-biometric": "^6.0.4",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@types/crypto-js": "^4.2.2",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "eslint-config-next": "^16.2.12",
    "firebase": "^12.16.0",
    "lucide-react": "^1.27.0",
    "next": "^15.2.0",
    "next-pwa": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
