# API backend URL (http/https). Se usa como base de todas las llamadas API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Capacitor / Android WebView scheme (GRAVE.001) ---
# 'http' para APK debug contra backend HTTP local (evita mixed-content).
# 'https' solo si el backend/API es HTTPS. Lo lee capacitor.config.ts en `cap sync`.
CAPACITOR_ANDROID_SCHEME=http

# Uso personal sin login: true desactiva la autenticación en el frontend.
# Debe coincidir con AUTH_DISABLED del backend.
NEXT_PUBLIC_AUTH_DISABLED=false

# --- Firebase (Google Login) ---
# Valores visibles en Firebase Console > Project Settings > Web App.
# Son públicos por diseño (config del cliente web); el backend verifica los
# tokens con el service account (FIREBASE_CREDENTIALS_JSON del .env).
# MED.007: SIN valores en estas env vars el login Google se desactiva
# (auth=null en firebase.ts) y google-auth.ts lanza un error claro. No hay
# fallback a credenciales del proyecto en el código.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Google OAuth client IDs (para Capacitor/Android) ---
# Web: client_type 3 de google-services.json.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android: client_type 1 de google-services.json.
NEXT_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
