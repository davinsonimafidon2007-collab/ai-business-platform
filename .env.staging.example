# =============================================================================
# AI Business Platform - Environment STAGING (template)
# =============================================================================
# Copia a .env.staging en el servidor de staging y rellena valores reales.
# NUNCA commitees valores reales. (Bloque 6 / DEVOPS)
# =============================================================================

# --- Application ---
ENVIRONMENT=staging
APP_URL=https://staging.example.com
APP_NAME=AI Business Platform API (staging)

# --- Security (REQUIRED, >=32 chars) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_staging_secret_at_least_32_chars_long

# --- Uso personal: en staging/prod SIEMPRE auth activa ---
AUTH_DISABLED=false
ALLOW_AUTH_DISABLED_IN_PROD=false

# --- CORS (dominios reales de staging; nunca '*') ---
CORS_ORIGINS=https://staging.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Request-ID,X-API-Key,X-Requested-With

# --- Database (credenciales propias de staging) ---
DATABASE_URL=postgresql+asyncpg://user_staging:pass_staging@db:5432/ai_business_platform_staging

# --- Redis (obligatorio en staging/prod) ---
REDIS_URL=redis://redis:6379/0

# --- SMTP / Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@staging.example.com
SMTP_USE_TLS=true

# --- Firebase / Google Login (credenciales de staging) ---
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_REQUIRED=true

# --- Scheduler ---
ENABLE_SCHEDULER=true
CACHE_REFRESH_INTERVAL=3600
SEARCH_HISTORY_TTL=2592000
MARKET_CACHE_TTL=21600
MAX_CONCURRENT_JOBS=4
PROVIDER_CANARY_INTERVAL=21600

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_PREMIUM=120
RATE_LIMIT_USER=30
RATE_LIMIT_READONLY=10

# --- API Key ---
API_KEY_PREFIX=abp_live
API_KEY_LENGTH=32

# --- Provider HTTP (claves de staging; proxy residencial si se usa mobile.de) ---
PROVIDER_HTTP_TIMEOUT=30.0
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_RETRY_BACKOFF_MIN=1
PROVIDER_HTTP_RETRY_BACKOFF_MAX=60
PROVIDER_HTTP_PROXY=
PROVIDER_HTTP_COOKIES=
PROVIDER_HTTP_MIN_DELAY_MS=800
ENABLE_MOBILE_DE=false

# --- Economics ---
DEFAULT_IMPORT_COST_PROFILE=SPAIN

# --- Providers offline/comparables ---
ENABLE_ES_MARKET_FIXTURE=false
DISABLE_ES_MARKET_AUTO=false
ENABLE_AUTOSCOUT24_ES=false
ENABLE_COCHES_NET_FIXTURE=false

# --- Backups (DEVOPS-001) ---
BACKUP_DIR=/var/backups
BACKUP_RETENTION=14
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Observabilidad (perfil obs) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_staging_grafana

# --- Modo de la app ---
APP_MODE=multiuser

# --- Logging ---
LOG_LEVEL=INFO
